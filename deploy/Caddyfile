# Caddy obtains and renews the TLS certificate for $KREN_DOMAIN automatically and redirects HTTP to
# HTTPS. It sets X-Forwarded-Proto, which the app trusts (server.forward-headers-strategy), so session
# cookies are issued as Secure. Server-Sent Events are streamed without buffering.
{$KREN_DOMAIN} {
	encode zstd gzip
	reverse_proxy app:8080
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
}
