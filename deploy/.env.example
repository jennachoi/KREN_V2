# Copy to deploy/.env on the server (never commit the real one).
KREN_DOMAIN=kren.canadacentral.cloudapp.azure.com

# Azure Database for PostgreSQL (TLS required)
SPRING_DATASOURCE_URL=jdbc:postgresql://<server-name>.postgres.database.azure.com:5432/kren?sslmode=require
SPRING_DATASOURCE_USERNAME=kren
SPRING_DATASOURCE_PASSWORD=<generated password>

# Demo settings
KREN_DEMO_SEED=true
KREN_DELIVERY_TIME_SCALE=60
